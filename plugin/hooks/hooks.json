{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:storeleads-brain:brain",
            "tool": "recall",
            "input": { "question": "${prompt}", "via": "hook", "client_session": "${session_id}" },
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:storeleads-brain:brain",
            "tool": "record",
            "input": { "answer": "${last_assistant_message}", "via": "hook", "client_session": "${session_id}" },
            "timeout": 10
          }
        ]
      }
    ]
  }
}
