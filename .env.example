# Public URL of this server (OAuth issuer; MCP endpoint is PUBLIC_URL/mcp). Must be https in production.
PUBLIC_URL=https://storeleads-brain.ecvision.ai
PORT=8080
# Behind a reverse proxy (needed for correct client IPs in rate limiting)
TRUST_PROXY=1

# token (personal bearer tokens, Claude Code only) or slack (OAuth, also claude.ai / Desktop)
AUTH_MODE=token
# Signs client ids, auth codes, access/refresh tokens. 32+ random chars. Rotating it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# slack mode — Slack app (OpenID Connect). Redirect URL in the Slack app: PUBLIC_URL/oauth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Only members of this workspace can sign in (T…)
SLACK_TEAM_ID=

# token mode: a file with one "token user_id [display name]" per line (deploy/new-token.sh), re-read on change,
# and/or inline pairs. In production tokens shorter than 32 characters are ignored.
TOKENS_FILE=
# ACCESS_TOKENS=tok-an:U_AN

# ClickHouse (see sql/schema.sql for the two users)
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_READ_USER=brain_read
CLICKHOUSE_READ_PASSWORD=
CLICKHOUSE_WRITE_USER=brain_write
CLICKHOUSE_WRITE_PASSWORD=
CLICKHOUSE_USAGE_DB=usage

# Hard cap on rows returned per query, and per-query time limit
QUERY_MAX_ROWS=500
QUERY_TIMEOUT_SECONDS=60
# A turn Claude never closed with `record` is logged after this many idle minutes
TURN_IDLE_MINUTES=15
# 1 = also keep prompts that never touched StoreLeads (the hooks see every prompt in every project)
LOG_ALL_TURNS=0

# Distiller (labels each turn and files memories). Off without a key.
ANTHROPIC_API_KEY=
DISTILL_MODEL=claude-opus-5-5
# DISTILL_DISABLED=1
